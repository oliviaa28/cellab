{
  "format_version": "2.0",
  "kind": "cells",
  "name": "Epidemic (deterministic)",
  "description": "S devine infectat daca are cel putin 'min_infected' vecini infectati; I1 -> I2 -> I3 -> R (vindecat dupa 3 pasi).",
  "states": [
    {"name": "S",  "symbol": "S", "color": "#A8DADC"},
    {"name": "I1", "symbol": "1", "color": "#F4A261"},
    {"name": "I2", "symbol": "2", "color": "#E76F51"},
    {"name": "I3", "symbol": "3", "color": "#9B2226"},
    {"name": "R",  "symbol": "R", "color": "#6A994E"}
  ],
  "neighborhood": {"type": "moore", "radius": 1},
  "parameters": {"min_infected": 2},
  "rules": [
    {"from": "I1", "to": "I2"},
    {"from": "I2", "to": "I3"},
    {"from": "I3", "to": "R"},
    {"from": "S",  "to": "I1", "when": {"count": ["I1", "I2", "I3"], "min": "min_infected"}}
  ]
}
