{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cellab/automaton.schema.json",
  "title": "CelLab automaton (format 2.0)",
  "type": "object",
  "required": [
    "format_version",
    "kind",
    "name",
    "states",
    "neighborhood",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": "2.0"
    },
    "kind": {
      "enum": [
        "cells",
        "agents"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "symbol"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        }
      }
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "default"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "int",
              "float"
            ]
          },
          "default": {
            "type": "number"
          }
        }
      }
    },
    "neighborhood": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "moore",
            "von_neumann",
            "1d"
          ]
        },
        "radius": {
          "const": 1
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      },
      "$comment": "May be empty for agent automata (for example Langton's Ant)."
    },
    "agent_types": {
      "$comment": "Phase 3: details are finalized by Person 4.",
      "type": "array"
    },
    "agent_order": {
      "$comment": "Phase 3.",
      "enum": [
        "fixed",
        "random",
        "bottom_up"
      ]
    },
    "agent_rules": {
      "$comment": "Phase 3.",
      "type": "array"
    }
  },
  "$defs": {
    "number_or_parameter": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "count_bound": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "rule": {
      "type": "object",
      "required": [
        "from"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "set": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "probability": {
          "$ref": "#/$defs/number_or_parameter"
        }
      }
    },
    "condition": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "count"
          ]
        },
        {
          "required": [
            "pattern"
          ]
        },
        {
          "required": [
            "all"
          ]
        },
        {
          "required": [
            "any"
          ]
        },
        {
          "required": [
            "not"
          ]
        },
        {
          "required": [
            "expr"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "count"
            ]
          },
          "then": {
            "$ref": "#/$defs/count_condition"
          }
        },
        {
          "if": {
            "required": [
              "pattern"
            ]
          },
          "then": {
            "$ref": "#/$defs/pattern_condition"
          }
        },
        {
          "if": {
            "required": [
              "all"
            ]
          },
          "then": {
            "$ref": "#/$defs/all_condition"
          }
        },
        {
          "if": {
            "required": [
              "any"
            ]
          },
          "then": {
            "$ref": "#/$defs/any_condition"
          }
        },
        {
          "if": {
            "required": [
              "not"
            ]
          },
          "then": {
            "$ref": "#/$defs/not_condition"
          }
        },
        {
          "if": {
            "required": [
              "expr"
            ]
          },
          "then": {
            "$ref": "#/$defs/expr_condition"
          }
        }
      ]
    },
    "count_condition": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "max"
          ]
        },
        {
          "required": [
            "in"
          ]
        }
      ],
      "properties": {
        "count": {
          "type": "string",
          "minLength": 1
        },
        "min": {
          "$ref": "#/$defs/count_bound"
        },
        "max": {
          "$ref": "#/$defs/count_bound"
        },
        "in": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/count_bound"
          }
        }
      }
    },
    "pattern_condition": {
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "all_condition": {
      "additionalProperties": false,
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        }
      }
    },
    "any_condition": {
      "additionalProperties": false,
      "properties": {
        "any": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        }
      }
    },
    "not_condition": {
      "additionalProperties": false,
      "properties": {
        "not": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "expr_condition": {
      "additionalProperties": false,
      "properties": {
        "expr": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}