{
  "description": "A formula that is cut off in the middle.",
  "expect": {
    "file": "automaton",
    "code": "BAD_EXPRESSION",
    "where": "/rules/0/when/all/1/expr"
  },
  "automaton": {
    "format_version": "2.0",
    "kind": "cells",
    "name": "Voter Model",
    "description": "O celula adopta opinia majoritara a vecinilor; la egalitate ramane neschimbata.",
    "states": [
      {
        "name": "A",
        "symbol": "A",
        "color": "#3A7BD5"
      },
      {
        "name": "B",
        "symbol": "B",
        "color": "#E4572E"
      }
    ],
    "neighborhood": {
      "type": "moore",
      "radius": 1
    },
    "rules": [
      {
        "from": "A",
        "to": "B",
        "when": {
          "all": [
            {
              "count": "B",
              "min": 5
            },
            {
              "expr": "count(B) >"
            }
          ]
        }
      },
      {
        "from": "B",
        "to": "A",
        "when": {
          "expr": "count(A) > count(B)"
        }
      }
    ]
  }
}
