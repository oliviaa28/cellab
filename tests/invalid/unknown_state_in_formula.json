    "states": [
      {
        "name": "A",
        "symbol": "A",
        "color": "#3A7BD5"
      },
      {
        "name": "B",
        "symbol": "B",
        "color": "#E4572E"
      }
    ],
    "neighborhood": {
      "type": "moore",
      "radius": 1
    },
    "rules": [
      {
        "from": "A",
        "to": "B",
        "when": {
          "expr": "count(B) > count(A)"
        }
      },
      {
        "from": "B",
        "to": "A",
        "when": {
          "expr": "count(C) > count(B)"
        }
      }
    ]
  }
