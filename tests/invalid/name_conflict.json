{
  "description": "'heat' is both a variable and a parameter.",
  "expect": {
    "file": "automaton",
    "code": "NAME_CONFLICT",
    "where": "/variables/0/name"
  },
  "automaton": {
    "format_version": "2.0",
    "kind": "cells",
    "name": "Forest Fire",
    "description": "Deterministic forest fire: a tree with at least one burning neighbor catches fire, fire burns out.",
    "states": [
      {
        "name": "EMPTY",
        "symbol": ".",
        "color": "#2B2B2B"
      },
      {
        "name": "TREE",
        "symbol": "T",
        "color": "#2E8B57"
      },
      {
        "name": "FIRE",
        "symbol": "F",
        "color": "#FF4500"
      }
    ],
    "neighborhood": {
      "type": "moore",
      "radius": 1
    },
    "rules": [
      {
        "from": "TREE",
        "to": "FIRE",
        "when": {
          "count": "FIRE",
          "min": 1
        }
      },
      {
        "from": "FIRE",
        "to": "EMPTY",
        "set": {
          "heat": "heat + 1"
        }
      }
    ],
    "variables": [
      {
        "name": "heat",
        "type": "float",
        "default": 0
      }
    ],
    "parameters": {
      "heat": 1
    }
  }
}