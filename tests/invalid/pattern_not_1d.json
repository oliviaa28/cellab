{
  "description": "'pattern' with a Moore neighborhood.",
  "expect": {
    "file": "automaton",
    "code": "PATTERN_NOT_1D",
    "where": "/rules/0/when/pattern"
  },
  "automaton": {
    "format_version": "2.0",
    "kind": "cells",
    "name": "Forest Fire",
    "description": "Deterministic forest fire: a tree with at least one burning neighbor catches fire, fire burns out.",
    "states": [
      {
        "name": "EMPTY",
        "symbol": ".",
        "color": "#2B2B2B"
      },
      {
        "name": "TREE",
        "symbol": "T",
        "color": "#2E8B57"
      },
      {
        "name": "FIRE",
        "symbol": "F",
        "color": "#FF4500"
      }
    ],
    "neighborhood": {
      "type": "moore",
      "radius": 1
    },
    "rules": [
      {
        "from": "TREE",
        "to": "FIRE",
        "when": {
          "pattern": [
            "FIRE",
            "TREE",
            "TREE"
          ]
        }
      },
      {
        "from": "FIRE",
        "to": "EMPTY"
      }
    ]
  }
}